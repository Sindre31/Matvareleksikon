node_modules/
.DS_Store
*.log

# Prerendered product pages — build.mjs writes ~5 000 of these from the live
# catalogue on every deploy. They are output, not source: committing them would
# bury real diffs and ship last week's prices to anyone reading the repo.
/gruppe/
/kategori/

# IndexNow fingerprints, written next to the pages above. Build output for the
# same reason: it describes the prices of one deploy. The copy that matters is
# the one on the live site, which is where the next build reads it from.
/indexnow-manifest.txt
